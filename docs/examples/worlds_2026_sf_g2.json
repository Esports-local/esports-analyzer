    {
     "start_sec": 210.796,
     "end_sec": 212.296,
     "id": 78,
     "speaker": null,
     "language": "ko",
     "text": "나가는 거 봐야돼"
    },
    {
     "start_sec": 212.296,
     "end_sec": 214.716,
     "id": 79,
     "speaker": null,
     "language": "ko",
     "text": "오노바 오노바 가디해져야지 오노바"
