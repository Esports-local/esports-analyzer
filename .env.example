# 이 파일을 .env 로 복사해서 값을 채운다 (.env 는 git 제외)
#   cp .env.example .env
#   docker run --rm --env-file .env -v "$PWD":/app ... esports-analyzer ...

# 숏폼 LLM (후보 순위·제목·자를 위치, 모음 요청 해석): Google AI Studio 에서 발급. 없으면 규칙 순서·자동 제목
GEMINI_API_KEY=

# asr 화자 구분 (선택): Hugging Face 토큰. pyannote 모델 약관 동의 필요
HF_TOKEN=
